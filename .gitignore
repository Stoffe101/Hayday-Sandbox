# Godot
.godot/
.import/
*.translation
export_credentials.cfg

# Build output
/build/
/artifacts/
*.tmp

# Python
__pycache__/
*.pyc
.venv/

# ---------------------------------------------------------------------------
# PROPRIETARY / PERMISSION-UNCERTAIN ART MUST NEVER BE COMMITTED.
# Anything a user imports from game files, wikis, screenshots etc. lives in
# assets/original/ (dev) or the user data directory (app). See
# docs/research/LEGAL_AND_LICENSING.md and docs/ASSET_PIPELINE.md.
# ---------------------------------------------------------------------------
assets/original/*
!assets/original/README.md
!assets/original/.gdignore
*.sc
*_tex.sc
*.apk
*.xapk
*.obb
*.ipa
reference_screenshots/
*.sctx
*.ktx
*.zktx
csv_client/
csv_logic/

# Tooling scratch (browser automation logs etc.)
.playwright-mcp/

# ---------------------------------------------------------------------------
# PRIVATE ORIGINAL ART (personal use only, never redistributed): the private
# storage root, installed/built packs and pack zips never belong in git.
# Enforced by tools/ci/check_private_leaks.py (CI + pre-commit/pre-push hooks,
# install with tools/ci/install_git_hooks.sh). See docs/PRIVATE_ASSETS.md.
# ---------------------------------------------------------------------------
hayday-sandbox-private-assets/
asset_packs/
hayday_original/
*.hdpack.zip
*.xapk
*.apks
*.apkm
*.aab
*.pck
private/
.leakcheck/
